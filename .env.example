# Get a free API key at https://resend.com after verifying your sending domain
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The inbox that should receive an email every time someone confirms/declines
ORGANIZER_EMAIL=you@example.com

# Must be an address on a domain you verified with Resend
FROM_EMAIL=invitations@yourdomain.com

# Used only by scripts/generate-guest-links.js to build the final links
SITE_URL=https://medistest2.netlify.app
